# ==============================================================================
# PharmaRCA Enterprise Platform - Unified Environment Configuration
# ==============================================================================

# Application Metadata
PROJECT_NAME="PharmaRCA Enterprise Platform"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG="false"

# Security & 21 CFR Part 11 Electronic Records Compliance
# Generate a cryptographically secure 32+ character key: openssl rand -hex 32
SECRET_KEY="generate-a-secure-32-byte-hex-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="secure_postgres_password_here"
POSTGRES_DB="pharmarca_qms"

# SQLAlchemy Async and Sync Connection Strings
DATABASE_URL="postgresql+asyncpg://postgres:secure_postgres_password_here@db:5432/pharmarca_qms"
SYNC_DATABASE_URL="postgresql://postgres:secure_postgres_password_here@db:5432/pharmarca_qms"

# Document & Evidence Storage
STORAGE_DIR="storage/evidence"
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB limit

# Groq LLM API Configuration
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_MAX_RETRIES=3
GROQ_TEMPERATURE=0.1

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:3000", "http://localhost:5173"]

