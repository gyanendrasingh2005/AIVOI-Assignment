# ==============================================================================
# PharmaRCA: Environment Configuration Template
# ==============================================================================

# Application Settings
PROJECT_NAME="PharmaRCA Enterprise Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT (21 CFR Part 11 Compliant)
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma separated in production)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="pharmarca_qms"
# Async SQLAlchemy database URL
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/pharmarca_qms"
# Sync database URL for Alembic migrations
SYNC_DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/pharmarca_qms"

# Document & Evidence File Storage
STORAGE_DIR="storage/evidence"
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB

# Groq LLM API Configuration
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_MAX_RETRIES=3
GROQ_TEMPERATURE=0.1
